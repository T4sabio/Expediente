{
  "name": "ronda-clinica-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "npm run test:unit && npm run test:security && npm run build",
    "audit": "npm audit --audit-level=high",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test e2e/smoke.spec.js",
    "test:a11y": "playwright test e2e/accessibility.spec.js",
    "test:perf": "playwright test e2e/performance.spec.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:browser",
    "test:browser": "playwright test",
    "test:security": "node --test tests/phase1Security.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "chart.js": "4.5.1"
  },
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "vite": "8.3.1",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0"
  },
  "optionalDependencies": {
    "@sentry/browser": "11.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.2"
}
